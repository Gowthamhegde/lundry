# Browser-safe Supabase values. These are intentionally public in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only Supabase values. Never expose or commit these.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay key ID is browser-safe; the secret is server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your-public-key
RAZORPAY_KEY_ID=rzp_test_your-public-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
